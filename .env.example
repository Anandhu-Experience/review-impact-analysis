# Supabase connection. Copy to .env (gitignored) and fill from
# Project Settings -> API Keys in the Supabase dashboard.
#
# Both values are safe in the browser bundle: the publishable key is meant to be public and
# RLS is what protects the data behind it. The secret key (sb_secret_… / service_role)
# bypasses RLS and must never go here.
#
# Leave the file absent to run the app entirely offline against the seed data.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Projects created before the publishable/secret split use the legacy JWT instead. Either
# name works; the publishable key wins when both are set.
# VITE_SUPABASE_ANON_KEY=
